# Backoffice credentials
ZIPGO_USER=admin
ZIPGO_PASS=

# Force localhost mode even when apps/root.txt is set
ZIPGO_LOCALHOST=

# Comma-separated list of IPs allowed to access the backoffice (all IPs allowed if unset)
ZIPGO_BO_ALLOW=

# --- Docker build & push ---
# Docker Hub username (also used as the default image namespace)
DOCKER_USERNAME=
# Docker Hub access token (create at https://hub.docker.com/settings/security)
DOCKER_PASSWORD=
# Optional overrides:
# DOCKER_IMAGE=youruser/zipgo   # full image name (defaults to $DOCKER_USERNAME/zipgo)
# DOCKER_TAG=latest             # image tag (defaults to latest)
